sudo apt update && sudo apt upgrade -y
sudo apt install git curl zsh ffmpeg 7zip jq poppler-utils fd-find ripgrep fzf zoxide imagemagick gcc kitty hyprland thunar tmux wofi mpv grim slurp hyprpaper openssh-server sshfs build-essential wl-clipboard
sudo ubuntu-drivers install

curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

curl -LsSf https://astral.sh/uv/install.sh | sh

curl -LO https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz
sudo tar -C /opt -xzf nvim-linux-x86_64.tar.gz
sudo ln -s /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim
rm nvim-linux-x86_64.tar.gz

git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
git clone https://github.com/zsh-users/zsh-autosuggestions ~/.zsh/zsh-autosuggestions
git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf


LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | \grep -Po '"tag_name": *"v\K[^"]*')
curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz"
tar xf lazygit.tar.gz lazygit
sudo install lazygit -D -t /usr/local/bin/
rm lazygit.tar.gz lazygit

chsh -s $(which zsh)

fc-cache -fv

while [[ -z "$git_name" ]]; do
  read -p "Enter your Git user.name: " git_name
done

while [[ -z "$git_email" ]]; do
  read -p "Enter your Git user.email: " git_email
done

read -p "Enter your GitHub Personal Access Token: " -s gh_token
echo
git config --global credential.helper store
echo "https://${git_name}:${gh_token}@github.com" >> ~/.git-credentials


ssh-keygen -t ed25519

IP="10.0.0.5"
HOSTNAME="master"
HOSTS_FILE="/etc/hosts"

echo "$IP $HOSTNAME" | sudo tee -a "$HOSTS_FILE" > /dev/null
echo "Set $HOSTNAME to $IP in $HOSTS_FILE"

ssh-copy-id master

sudo systemctl enable ssh
sudo systemctl start ssh

mkdir ~/workspace
systemctl --user daemon-reload
systemctl --user enable sshfs-mount.service
systemctl --user start sshfs-mount.service

systemctl --user enable tmux.service
systemctl --user start tmux.service

