(defwindow position_hud
  :monitor 0
  :exclusive false
  :stacking "overlay"
  :wm-ignore true
  :transparent true
  :windowtype "utility"
  :window-properties (
      :name "position_hud" ; Optional, but good practice
      :gtk-layer-shell-keyboard-mode "exclusive"
  )
  (hud_layout)
)

(defwidget hud_layout []
  (box
    :class "hud-main"
    :orientation "v"
    :spacing 10
    :halign "center"
    :valign "center"
    (label :text "Select Position (1-7)" :class "hud-title")

    (box
      :class "grid-container"
      :orientation "v"
      :spacing 5
      :halign "center"
      :valign "center"

      ;; --- Top Row (Left, Center Placeholder, Right) --- 
      (box :orientation "h" :spacing 5
        (position-button
          :label "1"
          :text "Top-Left (1280x720)"
          :class ""
          :command "dispatch setfloating 1; dispatch resizeactive exact 1280 720; dispatch moveactive exact 0 0"
        )
        ;; Added placeholder to fill the space in the grid
        (box :class "placeholder" :hexpand true)
        (position-button
          :label "3"
          :text "Top-Right (1280x720)"
          :class ""
          :command "dispatch setfloating 1; dispatch resizeactive exact 1280 720; dispatch moveactive exact 3840 0"
        )
      )

      ;; --- Full Height & Center Row (Left, Center, Right) ---
      (box :orientation "h" :spacing 5
        ;; Full-Height Left on the outside left
        (position-button
          :label "6"
          :text "Full-Height Left (1280x1440)"
          :class ""
          :command "dispatch setfloating 1; dispatch resizeactive exact 1280 1440; dispatch moveactive exact 0 0"
        )

        ;; Center button
        (position-button
          :label "5"
          :text "Center (2560x1440)"
          :class "center-btn"
          :command "dispatch setfloating 1; dispatch resizeactive exact 2560 1440; dispatch moveactive exact 1280 0"
        )

        ;; Full-Height Right on the outside right
        (position-button
          :label "7"
          :text "Full-Height Right (1280x1440)"
          :class ""
          :command "dispatch setfloating 1; dispatch resizeactive exact 1280 1440; dispatch moveactive exact 3840 0"
        )
      )

      ;; --- Bottom Row (Left, Center Placeholder, Right) --- 
      (box :orientation "h" :spacing 5
        (position-button
          :label "2"
          :text "Lower-Left (1280x720)"
          :class ""
          :command "dispatch setfloating 1; dispatch resizeactive exact 1280 720; dispatch moveactive exact 0 720"
        )
        ;; Added placeholder to fill the space in the grid
        (box :class "placeholder" :hexpand true)
        (position-button
          :label "4"
          :text "Lower-Right (1280x720)"
          :class ""
          :command "dispatch setfloating 1; dispatch resizeactive exact 1280 720; dispatch moveactive exact 3840 720"
        )
      )
    )

    (button
      :class "close-btn"
      :onclick "eww close position_hud"
      "Close (Esc)"
    )
  )
)

;; Reusable component for the position buttons 
(defwidget position-button [label text class command]
  (button
    :class "pos-btn ${class}"
    :onclick "hyprctl --batch \"${command}\" && eww close position_hud"
    (box :orientation "v" :spacing 3
      (label :text label :class "pos-label")
      (label :text text :class "pos-text")
    )
  )
)
