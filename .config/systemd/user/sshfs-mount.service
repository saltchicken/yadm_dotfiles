[Unit]
Description=Mount SSHFS Share
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RemainAfterExit=yes
ExecStart=/usr/bin/sshfs -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 master:/home/saltchicken/workspace /home/saltchicken/workspace
ExecStop=/bin/fusermount -uz /home/saltchicken/workspace
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

